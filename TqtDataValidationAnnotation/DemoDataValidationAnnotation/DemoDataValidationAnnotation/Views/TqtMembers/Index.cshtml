@model IEnumerable<DemoDataValidationAnnotation.Models.TqtMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TqtUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TqtPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TqtEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TqtPhone)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.TqtUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.TqtPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.TqtEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.TqtPhone)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
